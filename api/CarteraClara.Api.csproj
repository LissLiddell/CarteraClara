<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\index.html" Link="index.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\app.js" Link="app.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\domain.js" Link="domain.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\styles.css" Link="styles.css" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
